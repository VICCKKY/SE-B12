  """AUREUM - a beginner FastAPI app with a premium rewards experience."""

from fastapi import FastAPI, Path, Query
from fastapi.responses import HTMLResponse


app = FastAPI(
    title="AUREUM Rewards API",
    description="A beginner FastAPI assignment with a premium rewards theme.",
    version="1.0.0",
)


def get_tier(points: int) -> tuple[str, int, str]:
    """Return a member tier, the next goal and a color for the UI."""
    if points >= 2500:
        return "Obsidian", 5000, "#f0eee8"
    if points >= 1000:
        return "Platinum", 2500, "#a8b7ff"
    if points >= 500:
        return "Gold", 1000, "#d8ff4f"
    return "Member", 500, "#ff885c"


@app.get("/", tags=["Assignment"])
def read_root() -> dict:
    """Return the required welcome message as JSON."""
    return {
        "message": "Hello, FastAPI",
        "app": "AUREUM",
        "experience": "/experience",
        "interactive_docs": "/docs",
    }


@app.get("/member/{name}", tags=["Assignment"])
def read_member(
    name: str = Path(min_length=2, max_length=30, description="Member name"),
    points: int = Query(default=740, ge=0, le=9999, description="Reward points"),
) -> dict:
    """Use a path parameter and a query parameter to build a reward response."""
    clean_name = " ".join(name.strip().split()).title()
    tier, next_goal, color = get_tier(points)
    return {
        "member": clean_name,
        "points": points,
        "tier": tier,
        "next_goal": next_goal,
        "points_to_next_level": max(next_goal - points, 0),
        "accent": color,
        "message": f"Welcome to the {tier} circle, {clean_name}.",
    }


