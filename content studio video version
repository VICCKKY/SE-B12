def clear_outputs():
    s.report=None; s.selection=None; s.script=None; s.week=None

def job(label, fn):
    try:
        with st.spinner(label):
            return fn()
    except Exception as exc:
        # Do not expose raw provider errors: they can contain request/credential details.
        st.error(f'Could not complete this step ({type(exc).__name__}). Check keys, model access and quota, then retry. Your brief is preserved.')
        return None

s.setdefault('saved_ideas', {})
if 'next_page' in s:
    s.workspace = s.pop('next_page')

def go(page):
    s.next_page=page
    st.rerun()

def load_sample():
    s.brief={'channel':'இனிய வாழ்வே','language':'Tamil','audience':'Tamil-speaking families','idea':'Human and social well-being','tone':'Warm, relatable','answers':[]}
    s.approved=True;s.sample=True;s.report,s.selection=sample_research();s.script=None;s.week=None
    go('Discover')

