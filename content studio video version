if page=='Setup':
    st.title('Make the studio yours.')
    st.write('Live generation uses OpenAI. Web research uses Serper — a SerpApi key will not work here.')
    st.code('cp .env.example .env\n# Fill OPENAI_API_KEY and SERPER_API_KEY locally\nstreamlit run app.py', language='bash')
    st.link_button('Open official Serper dashboard', 'https://serper.dev/')
    st.info('This local setup saves the Serper key only in this project’s ignored .env file. It is never included in GitHub or content exports.')
    with st.form('serper_setup', clear_on_submit=True):
        serper_key = st.text_input('Serper API key', type='password', autocomplete='off')
        save_serper = st.form_submit_button('Save Serper key locally', type='primary')
    if save_serper:
        value = serper_key.strip()
        if not value or len(value) < 16 or any(c.isspace() for c in value):
            st.error('Enter a valid Serper key from your dashboard.')
        else:
            import os
            from dotenv import set_key
            env_path = Path(__file__).parent / '.env'
            if not env_path.exists():
                fd = os.open(env_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                os.close(fd)
            os.chmod(env_path, 0o600)
            set_key(str(env_path), 'SERPER_API_KEY', value)
            os.environ['SERPER_API_KEY'] = value
            st.success('Serper key saved. Open Create content to run live research. Saving does not verify the provider connection.')
    st.caption('OpenAI configuration is also read from .env. Never paste keys into briefs or writing guidance.')
    st.write('The preview is bound to this computer. Public hosting needs authentication, rate limits and per-user storage before sharing it as a service.')
    st.write('Local project folder:')
    st.code(str(Path(__file__).parent))
    st.stop()

