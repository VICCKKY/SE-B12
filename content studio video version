if page=='Channel setup':
    st.markdown('<div class="eyebrow">STEP 01 / CHANNEL CONTEXT</div>',unsafe_allow_html=True)
    st.title('Tell us about your channel.')
    st.write('Describe what you create, who you create for, and the story you want to tell.')
    with st.form('initial'):
        c1,c2=st.columns(2)
        channel=c1.text_input('Channel name',value='இனிய வாழ்வே')
        channel_url=st.text_input('Public YouTube channel URL (optional)',placeholder='https://www.youtube.com/@yourchannel')
        st.caption('Reference link only. Channel details are entered manually; private analytics are not accessed.')
        language=c2.selectbox('Script language',['Tamil','English','Tamil + English'])
        idea=st.text_area('What would you like to create?',value='Well-being மற்றும் social well-being பற்றிய ஒரு வார short-video content வேண்டும்.',height=90)
        c1,c2=st.columns(2)
        audience=c1.text_input('Who is it for? (optional)',placeholder='e.g. Tamil-speaking families, 30–55')
        tone=c2.selectbox('Voice',['Warm and conversational','Reflective storyteller','Clear and practical','Hopeful and humorous'])
        guidance=st.text_area('Optional writing guidance',placeholder='Your preferred style, examples, words to avoid. No secrets.',max_chars=5000)
        submitted=st.form_submit_button('Let’s clarify the brief →',type='primary')
    if submitted:
        from urllib.parse import urlparse
        parsed_url=urlparse(channel_url.strip())
        valid_url=not channel_url.strip() or (parsed_url.scheme=='https' and parsed_url.hostname in ('youtube.com','www.youtube.com','m.youtube.com'))
        if not valid_url: st.warning('Use a valid https://www.youtube.com/ channel link, or leave it empty.')
        elif not idea.strip() or not channel.strip(): st.warning('Add your channel name and idea first.')
        else:
            s.brief=dict(channel=channel,channel_url=channel_url.strip(),language=language,idea=idea,audience=audience,tone=tone,guidance=guidance)
            s.answers=[];s.round=1;s.approved=False;s.sample=False;clear_outputs()
            s.questions=['இந்த வீடியோவைப் பார்த்த பிறகு பார்வையாளர் என்ன உணர வேண்டும் அல்லது செய்ய வேண்டும்?',
                         'உறவுகள், தனிமை, மனஅழுத்தம், தினசரி பழக்கங்கள்—எதில் கவனம்? ஒரு வாழ்க்கை உதாரணம் சொல்ல முடியுமா?',
                         'யாரிடம் பேசுகிறோம்? வயது / சூழல், presenter style, தவிர்க்க வேண்டிய கருத்துகள் என்ன?']

    if s.brief and not s.approved:
        st.markdown('#### A little more context')
        st.caption(f'Clarification round {s.round} of up to 3. You decide when the brief is ready.')
        with st.form(f'answers_{s.round}'):
            replies=[st.text_area(q,key=f'answer_{s.round}_{i}') for i,q in enumerate(s.questions)]
            saved=st.form_submit_button('Save these answers')
        if saved:
            s.answers=[a for a in s.answers if a['question'] not in s.questions]
            s.answers.extend([{'question':q,'answer':a.strip()} for q,a in zip(s.questions,replies) if a.strip()])
            s.brief['answers']=s.answers
            st.success('Answers added to your working brief.')
        a,b=st.columns(2)
        if a.button('Ask deeper follow-up questions',disabled=not flags['OPENAI_API_KEY'] or s.round>=3 or not s.answers):
            result=job('Finding what needs more clarity…',lambda:backend.clarify(s.brief,s.answers))
            if result:
                s.questions=result.questions;s.round+=1;s.summary=result.summary;st.rerun()
        if b.button('This is enough — approve brief',type='primary'):
            s.brief['answers']=s.answers;s.approved=True;go('Discover')
        if s.get('summary'): st.info(s.summary)
        with st.expander('Review working brief',expanded=False): st.json(s.brief)

    st.stop()

