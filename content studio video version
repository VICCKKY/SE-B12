if s.report:
    st.caption('Research checked: '+s.report.checked_date)
    search=st.text_input('Search ideas',placeholder='Search by topic or angle…')
    cols=st.columns(len(s.report.topics))
    for i,(col,t) in enumerate(zip(cols,s.report.topics)):
        if search and search.casefold() not in (t.title+' '+t.angle).casefold(): continue
        with col,st.container(border=True):
            st.caption(('RECOMMENDED · ' if i==s.selection.selected_index else '')+t.trend_status.upper())
            st.markdown(f'#### {t.title}')
            st.write(t.angle)
            st.caption(t.evidence)
            st.caption('Views: '+t.views)
            is_saved=t.title in s.saved_ideas
            if st.button('Saved ✓' if is_saved else 'Save idea',key='save_'+str(i)):
                if is_saved: del s.saved_ideas[t.title]
                else: s.saved_ideas[t.title]=t.model_dump()
                st.rerun()
            for url in t.source_urls:
                if url.startswith(('https://','http://')): st.link_button('Source',url)
    st.info(s.selection.reason)
    st.caption(s.report.limitations)
    idx=st.selectbox('Choose the topic to write',range(len(s.report.topics)),index=s.selection.selected_index,
                     format_func=lambda i:s.report.topics[i].title)
    topic=s.report.topics[idx]
    if s.get('script_topic')!=topic.title:
        s.script=None;s.script_topic=topic.title
    st.subheader('03 / Write the one-minute story')
    if st.button('Generate script + 6-shot storyboard',type='primary'):
        if s.sample:
            if idx==0: s.script=sample_script()
            else: st.info('The offline example includes the first topic only. Use live research to write other topics.')
        else:
            result=job('Writer is drafting your story…',lambda:backend.write_script(s.brief,topic.model_dump()))
            if result: s.script=result
    if st.button('Build a 7-day topic plan',disabled=s.sample or not flags['OPENAI_API_KEY']):
        result=job('Planning seven distinct angles…',lambda:backend.week_plan(s.brief,s.report.model_dump()))
        if result: s.week=result

if s.script:
    draft=s.script
    st.markdown('### '+draft.title)
    st.caption('DRAFT · estimated 60 seconds · read aloud before recording')
    st.text_area('Complete narration — editable',draft.narration,height=200,key='edited_'+str(hash(draft.narration)))
    st.caption('Narration edits are exported below; storyboard is not automatically rewritten.')
    for shot in draft.shots:
        with st.expander(f'{shot.start:02d}–{shot.end:02d}s · {shot.visual}'):
            st.write(shot.narration);st.code(shot.prompt,language=None)
    st.write('**Caption:** '+draft.caption)
    st.write('**CTA:** '+draft.cta)
    st.info(draft.review_notes)
    data=draft.model_dump();data['narration']=s['edited_'+str(hash(draft.narration))]
    st.download_button('Download content pack · JSON',json.dumps(data,ensure_ascii=False,indent=2),'content-pack.json')
    md=f'# {draft.title}\n\n{data["narration"]}\n\n'+ '\n\n'.join(f'## {x.start}–{x.end}s\n{x.narration}\n\n{x.prompt}' for x in draft.shots)+f'\n\nCaption: {draft.caption}\n\nReview: {draft.review_notes}\n\nSources: '+ '\n'.join(draft.source_urls)
    st.download_button('Download script + storyboard · Markdown',md,'content-pack.md')
if s.week:
    st.subheader('Your seven-day editorial plan')
