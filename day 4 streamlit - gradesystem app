"""GradeVerse — a premium, gamified Streamlit grade manager."""

from html import escape

import streamlit as st

st.set_page_config(page_title="GradeVerse", page_icon="G", layout="wide", initial_sidebar_state="collapsed")


def get_grade(mark: int) -> str:
    """Return the same grade used in the original Python assignment."""
    if mark >= 90:
        return "A"
    if mark >= 80:
        return "B"
    if mark >= 70:
        return "C"
    if mark >= 60:
        return "D"
    return "E"


def rank_for_average(average: float) -> tuple[str, str]:
    if average >= 90:
        return "Diamond", "◆"
    if average >= 80:
        return "Platinum", "✦"
    if average >= 70:
        return "Gold", "●"
    if average >= 60:
        return "Silver", "◇"
    return "Rookie", "○"


def metric_card(label: str, value: str, note: str, color: str) -> str:
    return f'''<div class="metric-card" style="--glow:{color}">
        <div class="metric-top"><span>{label}</span><i></i></div>
        <strong>{value}</strong><small>{note}</small></div>'''


def badge(label: str, unlocked: bool, symbol: str) -> str:
    state = "unlocked" if unlocked else "locked"
    return f'<div class="badge {state}"><b>{symbol}</b><span>{escape(label)}</span></div>'


