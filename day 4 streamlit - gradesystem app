if students:
    rows = []
    for student in reversed(students):
        safe_name = escape(student["Name"])
        initial = escape(student["Name"][0].upper())
        rows.append(f'''<div class="student-row"><div class="avatar">{initial}</div>
            <div class="student-name"><b>{safe_name}</b><small>Grade unlocked</small></div>
            <div class="score">{student["Mark"]}<small>/100</small></div><div class="grade">{student["Grade"]}</div></div>''')
    st.markdown('<div class="student-feed">' + "".join(rows) + "</div>", unsafe_allow_html=True)
    with st.expander("Open assignment table"):
        st.dataframe(students, column_order=("Name", "Mark", "Grade"), hide_index=True, width="stretch")
    st.write("")
    if st.button("Reset complete roster"):
        st.session_state.students = []
        st.rerun()
else:
    st.markdown('<div class="empty-state">Your roster is quiet. Add the first student to start the class quest.</div>', unsafe_allow_html=True)

