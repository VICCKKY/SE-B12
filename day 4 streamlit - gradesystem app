left, right = st.columns([1.05, 0.95], gap="large")
with left:
    st.markdown('<div class="section-label">Add to the roster</div>', unsafe_allow_html=True)
    with st.form("student_form", clear_on_submit=True):
        name = st.text_input("Student name", placeholder="Example: Priya")
        mark = st.number_input("Mark", min_value=0, max_value=100, value=75, step=1)
        submitted = st.form_submit_button("ADD STUDENT  →")
        if submitted:
            clean_name = name.strip()
            if not clean_name:
                st.error("Please enter the student's name.")
            else:
                grade = get_grade(int(mark))
                st.session_state.students.append({"Name": clean_name, "Mark": int(mark), "Grade": grade})
                st.session_state.notice = f"{clean_name} joined the GradeVerse with grade {grade}."
                if grade == "A":
                    st.session_state.celebrate = True
                st.rerun()

